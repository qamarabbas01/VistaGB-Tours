# Public site URL (used for sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://vista-gb-tours.vercel.app

# --- Public business contact (shown in footer, /contact, JSON-LD) ---
# These are displayed on the public site, so they use NEXT_PUBLIC_.
# Do not commit real personal email or phone numbers; set them in
# .env.local and in the Vercel project environment.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_PHONE=+92 3000000000
# Optional E.164 form; derived from NEXT_PUBLIC_CONTACT_PHONE when omitted
# NEXT_PUBLIC_CONTACT_PHONE_TEL=+923000000000
# Optional; derived from the phone number when omitted
# NEXT_PUBLIC_CONTACT_WHATSAPP_URL=https://wa.me/923000000000
NEXT_PUBLIC_CONTACT_ADDRESS=Skardu, Gilgit-Baltistan, Pakistan
NEXT_PUBLIC_CONTACT_STREET=
NEXT_PUBLIC_CONTACT_CITY=Skardu
NEXT_PUBLIC_CONTACT_REGION=Gilgit-Baltistan
NEXT_PUBLIC_CONTACT_COUNTRY=PK
NEXT_PUBLIC_CONTACT_LOCATION_LABEL=Skardu, Gilgit-Baltistan, Pakistan
NEXT_PUBLIC_CONTACT_LOCATION_COORDS=35.8°N · 75.5°E · ALT 2228M

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Read only from API routes via src/lib/server-env.ts. Do not import that
# module from Client Components.

# Resend — required for the contact form
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified sender/domain in Resend
RESEND_FROM_EMAIL=VistaGB Tours <onboarding@resend.dev>

# Optional inbox override (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
CONTACT_EMAIL_TO=you@example.com

# Optional — AI Travel Assistant (/assistant)
# Without a key, the assistant still answers from VistaGB destination guides + live weather.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
